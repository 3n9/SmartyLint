{
    "name": "3n9/smarty-lint",
    "description": "Smarty AST-based linter CLI",
    "type": "project",
    "require": {
        "php": "^8.4",
        "3n9/smarty-ast": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "SmartyLint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SmartyLint\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml",
        "build-phar": "php -d phar.readonly=0 scripts/build-phar.php"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/3n9/SmartyAST.git"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": [
        "bin/smarty-lint"
    ],
    "require-dev": {
        "phpunit/phpunit": "^13"
    }
}
